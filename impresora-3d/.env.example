# ─────────────────────────────────────────────────────────────
#  IMPRESORA 3D · Variables de entorno (copia este archivo como .env)
#  ¡Nunca subas el archivo .env a GitHub! Ya está en .gitignore.
#  Todas son OPCIONALES: la app funciona sin ninguna.
# ─────────────────────────────────────────────────────────────

# Ruta donde se publica la app. En GitHub Pages: /nombre-del-repositorio/
BASE_PATH=/impresora-3d/

# URL pública completa de la app (para la vista previa en WhatsApp).
VITE_SITE_URL=https://arricio.github.io/impresora-3d/

# ID de cliente de la aplicación OAuth de Hugging Face (es público, no es secreto).
# Créala gratis en https://huggingface.co/settings/applications/new
VITE_HF_CLIENT_ID=

# Supabase (opcional, para sincronizar móvil y ordenador). Plan gratuito.
# La "anon key" es pública por diseño; la seguridad la dan las reglas RLS de supabase/esquema.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Tamaño máximo de imagen permitido, en MB (por defecto 10).
VITE_MAX_IMAGE_MB=10
